        <name>Validate When needed is not in past</name>
        <order/>
        <script><![CDATA[function onSubmit() {
   var whenNeeded = g_form.getValue('u_when_needed');
   if (!whenNeeded){
	return true;
   }
   var now = new Date();
   var neededDate = new Date(whenNeeded);
   if(neededDate < now){
	g_form.addErrorMessage('When needed non può essere nel passato');
	return false;
   }
   return true;
   
}]]></script>
